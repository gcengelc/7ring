# Ring Nerede servisi — ortam değişkenleri
# Kopyalayın: cp .env.example .env  (ve gerçek değerlerle doldurun)

PORT=4000
DB_PATH=./data/ring.db

# Öğrenci e-posta alan adı. İstemcideki src/data/stops.ts ile aynı olmalı.
MAIL_DOMAIN=@std.yeditepe.edu.tr

# SMTP tanımlı değilse doğrulama kodları sunucu günlüğüne yazılır.
# Üretimde bu alanlar doldurulmadan yayına çıkmayın.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ring Nerede <noreply@ringnerede.app>
