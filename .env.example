# Supabase bağlantısı (Project Settings → API).
# Bu dosyayı `.env` olarak kopyalayıp kendi değerlerinizi yazın; `.env`
# depoya gönderilmez. Değerler boş bırakılırsa uygulama demo modunda açılır.
EXPO_PUBLIC_SUPABASE_URL=https://PROJE-KIMLIGI.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ANON_KEY

# service_role anahtarı buraya GİRİLMEZ. O yalnızca Edge Function ortamında
# bulunur ve Supabase tarafından otomatik sağlanır.
