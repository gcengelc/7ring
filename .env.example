# Uygulama ortam değişkenleri — kopyalayın: cp .env.example .env.local
# Hepsi boşsa uygulama demo modunda açılır (bkz. src/api/index.ts).

# Supabase (README → Supabase). İkisi de doluysa Supabase kullanılır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Auth → Email OTP Length ile aynı olmalı.
EXPO_PUBLIC_SUPABASE_OTP_LENGTH=6

# Supabase yerine server/ klasöründeki Node servisi.
EXPO_PUBLIC_API_BASE_URL=
